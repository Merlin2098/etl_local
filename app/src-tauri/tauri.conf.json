{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Integrador RR. HH.",
  "identifier": "dev.etl-local.integrador",
  "build": {
    "devUrl": "http://localhost:5173/app.html",
    "frontendDist": "../ui/dist",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "principal",
        "title": "Integrador RR. HH.",
        "url": "app.html",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../../config/": "config/",
      "../ui/dist/": "ui/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
